{
	"name": "portalai",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"storybook": "turbo run storybook",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"lint:doc-pointers": "node scripts/check-doc-pointers.mjs",
		"lint:ci-cache": "node scripts/check-ci-cache.mjs",
		"lint:integration-skip": "node scripts/integration-skip-base.mjs --self-test",
		"lint:integration-shards": "node scripts/integration-shards.mjs --self-test",
		"lint:integration-durations": "node scripts/integration-shards.mjs check-durations",
		"lint:nginx-advisories": "node scripts/nginx-advisories.mjs --self-test",
		"lint:review-chain": "node scripts/check-review-chain.mjs",
		"lint:migrations": "node scripts/check-migrations.mjs",
		"lint:helm": "node scripts/check-helm.mjs",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"type-check": "turbo run type-check",
		"clean": "turbo run clean",
		"test": "turbo run test",
		"test:unit": "turbo run test:unit",
		"test:integration": "turbo run test:integration",
		"test:e2e": "turbo run test:e2e",
		"test:watch": "turbo run test:watch",
		"test:coverage": "turbo run test:coverage",
		"preinstall": "node -e \"const want=require('./package.json').engines.node;const w=want.replace('>=','').split('.').map(Number),h=process.versions.node.split('.').map(Number);const i=[0,1,2].find(k=>h[k]!==w[k]);if(i!==undefined&&h[i]<w[i]){console.error('Node '+process.version+' is below engines.node '+want+' (#900). Install the newest Node 22; for the devcontainer, rebuild it pulling node:22.');process.exit(1)}\"",
		"prepare": "test -f .husky/install.mjs && node .husky/install.mjs || true"
	},
	"devDependencies": {
		"@tanstack/router-plugin": "^1.168.48",
		"drizzle-orm": "^0.45.2",
		"husky": "^9.1.7",
		"jsonc-parser": "^2.3.1",
		"lint-staged": "^17.0.8",
		"prettier": "~3.8.1",
		"turbo": "^2.3.3",
		"typescript": "^5.7.2",
		"wait-on": "^9.0.4",
		"yaml": "^2.9.0",
		"zod": "^4.3.6"
	},
	"packageManager": "npm@10.9.2",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=22.23.4"
	},
	"overrides": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0"
	},
	"lint-staged": {
		"{apps,packages}/*/{src,scripts}/**/*.{ts,tsx,json,css,scss,astro}": "prettier --write"
	}
}
