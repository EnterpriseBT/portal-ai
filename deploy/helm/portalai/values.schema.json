{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Portals AI residency chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "api": { "$ref": "#/$defs/image" },
        "web": { "$ref": "#/$defs/image" }
      },
      "required": ["api", "web"]
    },
    "imagePullSecrets": { "type": "array" },
    "deployMode": {
      "type": "string",
      "enum": ["saas", "residency"]
    },
    "oidc": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "issuer": { "type": "string" },
        "audience": { "type": "string" },
        "clientId": { "type": "string" }
      }
    },
    "config": { "type": "object" },
    "secrets": { "type": "object" },
    "existingSecret": { "type": "string" },
    "api": { "type": "object", "additionalProperties": true },
    "web": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "basemap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["default", "custom", "none"] },
            "styleUrl": { "type": "string", "pattern": "^([Hh][Tt][Tt][Pp][Ss]?://[^\\s]+)?$" },
            "styleUrlDark": { "type": "string", "pattern": "^([Hh][Tt][Tt][Pp][Ss]?://[^\\s]+)?$" },
            "attribution": { "type": "string" }
          },
          "required": ["mode"],
          "if": { "properties": { "mode": { "const": "custom" } } },
          "then": {
            "properties": { "styleUrl": { "minLength": 1 } },
            "required": ["styleUrl"]
          }
        }
      }
    },
    "postgresql": { "type": "object", "additionalProperties": true },
    "redis": { "type": "object", "additionalProperties": true },
    "objectStorage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
        "publicHost": { "type": "string", "pattern": "^[A-Za-z0-9.-]*$" }
      }
    },
    "bundledIssuer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "pattern": "^[A-Za-z0-9.-]*$" },
        "realm": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "clientId": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 }
      }
    },
    "minio": {
      "not": {},
      "description": "Replaced by objectStorage (#946)."
    }
  },
  "required": ["image", "deployMode"],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    }
  }
}
