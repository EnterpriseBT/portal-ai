{
  "name": "Portals AI",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000, 3001, 3002, 5432, 7006, 7007, 4983, 9092],
  "portsAttributes": {
    "3000": {
      "label": "Web App"
    },
    "3001": {
      "label": "API"
    },
    "3002": {
      "label": "Marketing Site"
    },
    "5432": {
      "label": "PostgreSQL"
    },
    "4983": {
      "label": "PostgreSQL"
    },
    "7006": {
      "label": "Storybook Core"
    },
    "7007": {
      "label": "Storybook App"
    },
    "9092": {
      "label": "Local S3 (s3mock)"
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
    // The host's kubeconfig, read-only, for Docker Desktop's Kubernetes (#946).
    // Its server is the host's 127.0.0.1, so kubectl here uses a copy pointed
    // at kubernetes.docker.internal (deploy/helm/portalai/README.md).
    "source=${localEnv:HOME}/.kube,target=/root/.kube-host,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml",
        "astro-build.astro-vscode",
        "ms-azuretools.vscode-containers",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  },
  "remoteUser": "root",
  "onCreateCommand": "npm i"
}
