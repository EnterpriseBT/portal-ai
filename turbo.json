{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // Artifacts round-trip through a third party and are then executed and
  // deployed, so turbo HMAC-signs them and rejects any that fail verification
  // (#454). The policy is split on purpose: fail-OPEN on cache availability
  // (an unreachable cache just runs the work), fail-CLOSED on cache integrity.
  // A blanket fail-open on integrity is what turns a poisoned artifact into a
  // green required check. Needs TURBO_REMOTE_CACHE_SIGNATURE_KEY in CI.
  "remoteCache": { "signature": true },
  // Root files outside every package that still change task results. The test
  // services' image tags live here, so `test:integration` must hash this file
  // (#454). Known cost: the devcontainer's own `dev` service lives here too,
  // so a purely local devcontainer edit invalidates every cached task. Accepted
  // — the file changes rarely, and a full invalidation is a performance event,
  // not a correctness one. The escalation, if it ever bites, is splitting the
  // test services into their own compose file.
  "globalDependencies": ["docker-compose.yml"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "test:unit",
        "test:integration"
      ],
      "cache": false
    },
    "test:unit": {
      "dependsOn": [
        "^build"
      ],
      // No `outputs`: these scripts run `jest` WITHOUT `--coverage`, so the
      // coverageDirectory is never written and turbo warns "no output files
      // found" on every cache miss (#454). A test task's cacheable result is
      // its log and exit status, which turbo stores regardless. Re-add the
      // coverage glob only if the script starts passing `--coverage`.
      "cache": true
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      // Cacheable as of #454 — the most expensive job in CI (~6m) and the one
      // that most often re-runs against an unchanged tree.
      //
      // What makes this safe is that every input that can change the result is
      // hashed: the package's own source and its drizzle/ migrations (turbo's
      // default inputs), its dependencies (dependsOn ^build), the two env vars
      // below, and — via globalDependencies — docker-compose.yml, which is
      // where the postgres/redis image tags live. Change any of them and this
      // misses and genuinely re-runs.
      //
      // Known limits, both accepted: a mutable image tag can move underneath a
      // pinned tag string, and caching a pass means a FLAKY test stops
      // re-rolling the dice for that exact input hash. Neither can turn a real
      // failure green — a failing task is never written to the cache at all.
      //
      // Revert path if this ever misleads: set `cache` back to false. It is a
      // one-line change with no other moving parts.
      "cache": true,
      "env": [
        "INTEGRATION_TEST_DATABASE_URL",
        "REDIS_URL"
      ]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "build-storybook": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    }
  }
}