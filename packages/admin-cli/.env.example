# portalai (admin-cli) — LOCAL env only (#632).
#
# For `--env local`, this package's `.env` is auto-loaded (non-overriding), so
# you don't have to export these by hand. Copy this file to `.env` and fill in
# the same values your local stack uses (see apps/api/.env). An explicit shell
# export still wins over this file.
#
#   cp packages/admin-cli/.env.example packages/admin-cli/.env
#
# app-dev / prod IGNORE this file — they resolve DATABASE_URL and AUTH0_* from
# AWS Secrets Manager / SSM, never from a local .env.

# Local Postgres — org / user / member / tier DB operations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portal_ai

# Auth0 device flow for `portalai login --env local` (your local tenant).
AUTH0_DOMAIN=your-local-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.local.portalsai.io
AUTH0_CLI_CLIENT_ID=your-local-cli-client-id
