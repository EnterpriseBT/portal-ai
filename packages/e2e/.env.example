# Copy to packages/e2e/.env (git-ignored) so e2e:auth / e2e:seed load the
# test-user credentials without per-shell exports. Values already exported in
# the shell take precedence over this file. NEVER commit the real .env.

# The org OWNER identity (default): e2e:auth with no --identity, seeded as owner.
E2E_AUTH0_USERNAME=test-user@example.com
E2E_AUTH0_PASSWORD=change-me

# Multi-role identities (#620) — each needs its own dev-tenant Database user.
# e2e:auth:admin / e2e:auth:member capture their sessions; e2e:seed links them
# as admin / member of the e2e-fixture org.
E2E_AUTH0_USERNAME_ADMIN=e2e-admin@example.com
E2E_AUTH0_PASSWORD_ADMIN=change-me
E2E_AUTH0_USERNAME_MEMBER=e2e-member@example.com
E2E_AUTH0_PASSWORD_MEMBER=change-me

# Optional — defaults to http://localhost:3000
# E2E_BASE_URL=http://localhost:3000
