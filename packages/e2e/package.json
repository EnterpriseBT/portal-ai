{
  "name": "@portalai/e2e",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Playwright browser harness for agent-guided UI smoke walks against the local dev stack (#304). Auth fixture + seeded org baseline, Playwright specs, and deployed-env (app-dev/prod) QA sessions (#489). Node-only.",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,json}\" \"playwright.config.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,json}\" \"playwright.config.ts\"",
    "type-check": "tsc --noEmit",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "true",
    "test:e2e": "dotenv -e .env -- playwright test",
    "test:e2e:ui": "dotenv -e .env -- playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium",
    "e2e:stack:up": "scripts/e2e-stack.sh up",
    "e2e:stack:down": "scripts/e2e-stack.sh down",
    "e2e:seed": "dotenv -e .env -- sh -c 'npm --workspace @portalai/api run db:seed:org -- --name e2e-fixture --owner-email \"$E2E_AUTH0_USERNAME\" --admin-email \"$E2E_AUTH0_USERNAME_ADMIN\" --member-email \"$E2E_AUTH0_USERNAME_MEMBER\" --all-toolpacks'",
    "e2e:auth": "dotenv -e .env -- tsx src/setup/auth.setup.ts",
    "e2e:auth:admin": "dotenv -e .env -- tsx src/setup/auth.setup.ts --identity admin",
    "e2e:auth:member": "dotenv -e .env -- tsx src/setup/auth.setup.ts --identity member",
    "e2e:auth:all": "npm run e2e:auth && npm run e2e:auth:admin && npm run e2e:auth:member",
    "e2e:auth:app-dev": "dotenv -e .env -- tsx src/setup/auth.setup.ts --env app-dev",
    "e2e:auth:prod": "dotenv -e .env -- tsx src/setup/auth.setup.ts --env prod",
    "e2e:stub:anthropic": "tsx src/stubs/anthropic-stub.ts",
    "e2e:auth:app-dev:admin": "dotenv -e .env -- tsx src/setup/auth.setup.ts --env app-dev --identity admin",
    "e2e:auth:app-dev:member": "dotenv -e .env -- tsx src/setup/auth.setup.ts --env app-dev --identity member",
    "e2e:auth:prod:admin": "dotenv -e .env -- tsx src/setup/auth.setup.ts --env prod --identity admin",
    "e2e:auth:prod:member": "dotenv -e .env -- tsx src/setup/auth.setup.ts --env prod --identity member",
    "e2e:use": "tsx src/setup/use-identity.ts",
    "e2e:qa:setup": "scripts/setup-qa-auth0.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@portalai/core": "*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "prettier": "~3.8.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@portalai/cli-env": "*"
  }
}
