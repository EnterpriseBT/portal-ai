# portalops (devops-cli) — LOCAL env only (#632).
#
# For `--env local`, this package's `.env` is auto-loaded (non-overriding), so
# you don't have to export DATABASE_URL by hand. Copy this file to `.env` and
# fill in the same value your local stack uses (see apps/api/.env). An explicit
# shell export still wins over this file.
#
#   cp packages/devops-cli/.env.example packages/devops-cli/.env
#
# app-dev / prod IGNORE this file — they resolve the DB from AWS Secrets Manager
# over an SSM tunnel, never from a local .env.

# Local Postgres — db psql / reset / seed / tunnel targets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portal_ai
