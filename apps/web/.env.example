# Auth0 Configuration
# Find these in the Auth0 dashboard under Applications > your SPA app.
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_AUDIENCE=https://your-tenant.us.auth0.com

# Build metadata (injected by CI pipeline; safe defaults for local dev)
VITE_APP_VERSION=dev
VITE_APP_SHA=local

# API base URL prepended to all /api/* requests.
# Empty in local dev — the Vite dev server proxies /api/* to localhost:3001.
# In deployed environments set this to the full API origin (e.g. https://api-dev.portalsai.io).
VITE_API_BASE_URL=

# Business contact addresses (#369). SSM is the single write path; the deploy
# injects these. qa@portalsai.io serves every role outside prod, so a local or
# staging build can never advertise a customer-facing inbox.
VITE_SUPPORT_EMAIL=qa@portalsai.io
VITE_SALES_EMAIL=qa@portalsai.io

# Marketing-site origin (#506) — where the login screen's Terms/Privacy consent
# links point. Per-env; the deploy injects it (app-dev site-dev.portalsai.io,
# prod www.portalsai.io). Empty falls back to the prod origin.
VITE_SITE_URL=

# Google Picker (#408). The connector requests only the non-sensitive
# `drive.file` scope, so the user grants one spreadsheet at a time through
# Google's own Picker — which runs in the browser and needs these three.
# The client id must be the SAME OAuth client the API uses: a different one
# mints a grant the server's token cannot see. The project number is that
# client id's numeric prefix and is passed to the Picker as setAppId —
# without it no per-file grant is created at all.
# The API key is browser-exposed by design; restrict it by HTTP referrer.
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=
