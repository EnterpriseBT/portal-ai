# ─────────────────────────────────────────────────────────────────────────
# @portalai/api — environment
#
# This file is the authoritative inventory of every variable the API reads.
# A test (src/__tests__/env-example-parity.test.ts) fails if a `process.env`
# read appears in the code without a line here, so "grep the source" is never
# the answer to "what do I need to set?".
#
# Four tiers, by what you have to do about them:
#
#   1. REQUIRED     — uncommented, with a working local value. The app does
#                     not run correctly without these.
#   2. CAPABILITY   — present but empty. Each one switches a feature on; the
#                     app boots fine without it and that feature degrades.
#   3. TUNABLES     — commented out, showing the real default. Uncomment only
#                     to override.
#   4. TEST / DEV   — commented out. Only the local dev tooling reads these.
#
# Deployed environments do NOT use this file. Their values live in AWS
# Secrets Manager / SSM and are managed with `portalops vars` — but only for
# keys that are operator-settable per environment. Tunables and template-
# computed values (REDIS_URL, UPLOAD_S3_*, the OAuth redirect URIs) are
# deliberately not in that catalog.
# ─────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════
# 1. REQUIRED
# ═════════════════════════════════════════════════════════════════════════

# Server Configuration
PORT=3001

# CORS Configuration (comma-separated urls)
# Load-bearing beyond CORS: the first entry is the origin Stripe checkout and
# billing-portal return URLs are built from (billing.service.ts).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Auth0 Configuration
AUTH0_AUDIENCE=https://api.portalsai.local
AUTH0_DOMAIN=dev-xxxxxxxxxxxxxxxxx.us.auth0.com

# Database Configuration
# Use "postgres" as the host when running inside the devcontainer (docker-compose network)
# Use "localhost" if running the API outside of Docker with a local/forwarded Postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/portal_ai

# Redis Configuration
# Use "redis" as the host when running inside the devcontainer (docker-compose network)
# Use "localhost" if running the API outside of Docker with a local/forwarded Redis
REDIS_URL=redis://redis:6379
# If running outside Docker, use: redis://localhost:6380

# Anthropic API key — the portal agent. Without it, every agent turn fails.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# System-actor identifier — used as createdBy/updatedBy for platform-initiated writes
SYSTEM_ID="SYSTEM"

# Encryption key for securing connector credentials at rest (base64-encoded, 32 bytes)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# HMAC key signing the short-lived `state` token in the OAuth dance.
# Shared by all OAuth-driven connectors (google-sheets, microsoft-excel).
# Distinct from ENCRYPTION_KEY — generate with: openssl rand -base64 32
OAUTH_STATE_SECRET=

# Auth0 Webhook Secret (shared secret for HMAC-SHA256 signature verification)
AUTH0_WEBHOOK_SECRET=

# Logging Configuration
# LOG_LEVEL: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info

# LOG_FORMAT: pretty (colorized, human-readable) or json (structured) (default: pretty)
LOG_FORMAT=pretty

# Build metadata (injected by CI pipeline; safe defaults for local dev)
BUILD_VERSION=dev
BUILD_SHA=local

# The API's externally-reachable origin, handed to third-party webhook
# toolpack runtimes as the pull-on-read callback (#124):
#   <PUBLIC_API_BASE_URL>/api/webhook/handle/<id>
# The localhost default is right for a runtime on this machine. Point it at
# your ngrok URL when the runtime is a real third party, or it will be told
# to call back to its own loopback. Deployed environments set this from the
# stack's Subdomain + DomainName (#382).
PUBLIC_API_BASE_URL=http://localhost:3001


# ═════════════════════════════════════════════════════════════════════════
# 2. CAPABILITY KEYS — each switches a feature on; absent, it degrades
# ═════════════════════════════════════════════════════════════════════════

# Stripe subscription billing (#176). Use TEST-MODE keys everywhere except prod.
# Prefer a RESTRICTED key (rk_test_…) over the account secret key (sk_test_…),
# scoped to only what the API calls: Customers (write), Checkout Sessions
# (write), Billing Portal (write), Subscriptions (write), Prices (read).
# No Stripe account? `stripe sandbox create` mints keyless sandbox credentials.
# Local dev webhook forwarding (prints the whsec_… signing secret to use below):
#   stripe listen --forward-to localhost:3001/api/webhooks/stripe
# Absent keys: billing endpoints + webhook return 503; the app boots fine.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web search (Tavily) — backs the `web_search` tool, an `expensive` cost
# class. Absent: the tool isn't constructed and the agent can't search.
# Get a key at https://app.tavily.com/
TAVILY_API_KEY=

# Geocoding (#315) — Mapbox access token for the GIS pack's geocode /
# reverse_geocode / bulk_geocode_records tools. Absent: the map tool still
# works, but the geocode tools aren't constructed (a keyless station keeps
# visualize_map). Get a token at https://account.mapbox.com/access-tokens/
GEOCODING_API_KEY=

# Google OAuth (google-sheets connector)
# Per-env Google Cloud OAuth 2.0 Web Application client.
# In Google Console: Credentials → OAuth client ID → Web application.
# Authorized redirect URI must exactly match GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/connectors/google-sheets/callback

# Microsoft OAuth (microsoft-excel connector)
# Per-env Microsoft Entra app registration. In Entra: App registrations →
# New registration → Web platform. Redirect URI must exactly match
# MICROSOFT_OAUTH_REDIRECT_URI below. Required API permissions (delegated):
# openid, profile, email, offline_access, User.Read, Files.Read.All.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3001/api/connectors/microsoft-excel/callback
# Tenant scope — `common` (default) accepts personal MSAs + work/school
# accounts; `organizations` is work/school only; `consumers` is personal
# only; or set to a specific tenant id for a single-tenant deployment.
MICROSOFT_OAUTH_TENANT=common

# AWS S3 Configuration (file uploads)
# Credentials are resolved automatically via the AWS SDK credential chain:
#   1. These env vars  2. ~/.aws/credentials  3. IAM instance role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=us-east-1
UPLOAD_S3_PREFIX=uploads

# Marketing-site rebuild dispatch (#311). A fine-grained PAT scoped to this
# repo (Contents: read + repository dispatch), and the owner/repo it fires
# at. Absent: dispatch is a no-op and the nightly scheduled rebuild is the
# safety net — a missing token degrades freshness, never correctness.
GITHUB_DISPATCH_TOKEN=
# GITHUB_DISPATCH_REPO=EnterpriseBT/portal-ai

# ngrok auth token (used for webhook tunneling to localhost)
NGROK_AUTHTOKEN=your-ngrok-authtoken-here


# ═════════════════════════════════════════════════════════════════════════
# 3. TUNABLES — commented lines show the real default; uncomment to override
# ═════════════════════════════════════════════════════════════════════════

# Stripe Tax on checkout (#217): default ON. Requires one-time Dashboard
# setup per environment (Settings → Tax): origin/head-office address (test
# mode accepts a dummy address), default tax behavior (exclusive), and a
# registration per collecting jurisdiction. An unconfigured sandbox opts
# out EXPLICITLY:
# STRIPE_AUTOMATIC_TAX=false

# Per-stage model overrides for interpret(). Both default to Haiku 4.5 —
# narrow, schema-constrained sub-tasks it handles in ~1s vs ~4s on Sonnet.
# Point at any Anthropic model id to roll back without a deploy.
# INTERPRET_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# INTERPRET_AXIS_NAME_MODEL=claude-haiku-4-5-20251001

# Tool-usage audit ledger retention (#179): rows older than this many months
# are hard-deleted by the daily maintenance purge (04:00 UTC).
# LEDGER_RETENTION_MONTHS=24

# Soft-deleted `entity_records` retention (#442): the daily maintenance purge
# (04:30 UTC) hard-deletes tombstones past their window. Two windows, chosen
# by whether the row's parent connector_entity is ALSO soft-deleted —
# orphans can never be referenced again, so they go sooner. See
# apps/api/README.md → "Soft-delete retention".
# ENTITY_RECORD_ORPHAN_RETENTION_DAYS=7
# ENTITY_RECORD_RETENTION_DAYS=30

# How long a re-delivered layout_plan_commit pass waits for the instance sync
# lock before handing the attempt back to BullMQ (#461). Must exceed any
# plausible commit duration — a timeout means the holder is presumed dead but
# its session has not dropped. Default 15 minutes.
# LAYOUT_PLAN_COMMIT_LOCK_WAIT_MS=900000

# Stranded-job reconciliation (#391): a non-terminal job whose BullMQ entry
# is gone AND whose last write is older than the threshold is marked failed
# by the sweep (runs at boot + every interval tick). The threshold must
# exceed the longest legitimate quiet period between progress writes.
# JOB_STRANDED_THRESHOLD_MS=900000
# JOB_STRANDED_SWEEP_INTERVAL_MS=300000

# Per-IP fixed-window cap on the anonymous /api/public router. Generous by
# design: the marketing site fetches the snapshot ONCE per build, so anything
# near this ceiling is a scraper, not a legitimate consumer.
# PUBLIC_SITE_RATE_LIMIT_PER_MIN=60

# Body-parser cap for express.json(). Post-streaming-cutover no legitimate
# request body exceeds a few MB (layout plans + region hints). 4 MB.
# REQUEST_JSON_LIMIT_BYTES=4194304

# ── File upload / spreadsheet parsing
# Presigned PUT lifetime, seconds.
# UPLOAD_S3_PRESIGN_EXPIRY_SEC=1800
# Per-session file count and per-file size caps. 250 MB.
# UPLOAD_MAX_FILES_PER_SESSION=25
# UPLOAD_MAX_FILE_SIZE_BYTES=262144000
# Size cap for the LEGACY multipart POST /api/file-uploads/parse path only —
# the streaming pipeline consults UPLOAD_MAX_FILE_SIZE_BYTES instead. 25 MB.
# FILE_UPLOAD_PARSE_MAX_BYTES=26214400
# Per-sheet cell threshold: under it the sheet ships inline in the parse
# response, over it falls back to the lazy slice endpoint.
# FILE_UPLOAD_INLINE_CELLS_MAX=1000000
# Per-request rectangle cap for GET /api/file-uploads/sheet-slice, so a
# runaway client can't pull a whole sheet in one call.
# FILE_UPLOAD_SLICE_CELLS_MAX=50000
# Redis TTL (seconds) for the parsed-workbook cache keyed by uploadSessionId.
# FILE_UPLOAD_CACHE_TTL_SEC=3600
# Row-chunk granularity for the streaming workbook cache. Each chunk is one
# Redis key — too small and a slice MGETs dozens of keys; too large and parse
# buffers get fat. 1000 balances these for typical CSV row widths.
# FILE_UPLOAD_CACHE_ROWS_PER_CHUNK=1000
# Accepted upload extensions (comma-separated).
UPLOAD_ALLOWED_EXTENSIONS=.csv,.tsv,.xlsx,.xls

# sql_query job-tier escalation trigger (#130). The runtime EXPLAINs a
# validated sql_query first; when PG's estimated total plan cost crosses this
# threshold the read escalates to the 120s off-thread job tier up front,
# skipping a wasted synchronous attempt. PG's cost unit is arbitrary, so this
# is a starting point to tune against real traffic.
# SQL_QUERY_JOB_COST_THRESHOLD=1000000

# Emergency rollback flags for outbound toolpack webhooks. Both default
# false. Flipping SSRF stops resolving/filtering outbound IPs; flipping
# signing stops appending HMAC headers. The static URL check at registration
# is unaffected by either.
# TOOLPACK_DISABLE_SSRF_FILTER=false
# TOOLPACK_DISABLE_SIGNING=false
# Max runtime response body before the call aborts. 1 MB. (The schema /
# metadata cap is a separate 256 KB, declared in code.)
# TOOLPACK_RUNTIME_MAX_RESPONSE_BYTES=1048576


# ═════════════════════════════════════════════════════════════════════════
# 4. TEST / DEV TOOLING — read only by local scripts, never by the server
# ═════════════════════════════════════════════════════════════════════════

# The mock toolpack webhook server (`npm run webhook:toolpack`), used to
# exercise custom-toolpack registration and runtime calls locally.
# MOCK_TOOLPACK_SIGNING_SECRET=
# Injected latency, milliseconds, for testing timeouts.
# MOCK_TOOLPACK_LATENCY_MS=0
# Fail every Nth call (0 disables) for testing retry/error paths.
# MOCK_TOOLPACK_FLAKY_MOD=0
