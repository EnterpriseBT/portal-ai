{
  "name": "@portalai/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:tokens && astro dev --port 3002",
    "build:tokens": "node scripts/generate-tokens.mjs",
    "build": "npm run build:tokens && astro build",
    "preview": "astro preview --port 3002",
    "lint": "eslint src scripts --ext .ts,.mjs,.astro --max-warnings 0",
    "lint:fix": "eslint src scripts --ext .ts,.mjs,.astro --max-warnings 0 --fix",
    "format": "prettier --write \"{src,scripts}/**/*.{ts,json,css,astro}\"",
    "format:check": "prettier --check \"{src,scripts}/**/*.{ts,json,css,astro}\"",
    "type-check": "astro check",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "true",
    "clean": "rm -rf dist .astro src/styles/tokens.css"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@portalai/core": "*",
    "astro": "^5.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.3",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.2"
  }
}
