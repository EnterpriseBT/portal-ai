---
/** Site-wide footer. Contact addresses come from the build snapshot, so
 *  `portalops vars set SUPPORT_EMAIL` reaches every page on the next
 *  rebuild — no address is hardcoded here. */
import { siteConfig } from "../lib/site-context.js";

const { supportEmail, salesEmail } = siteConfig.contact;
const year = 2026;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <nav aria-label="Footer">
      <ul>
        <li><a href="/features/">Features</a></li>
        <li><a href="/use-cases/">Use cases</a></li>
        <li><a href="/pricing/">Pricing</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
    </nav>

    <p class="site-footer__contact">
      Support: <a href={`mailto:${supportEmail}`}>{supportEmail}</a> · Sales:
      <a href={`mailto:${salesEmail}`}>{salesEmail}</a>
    </p>

    <p class="site-footer__legal">© {year} Portals AI</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: calc(var(--space-unit) * 8);
    border-top: 1px solid var(--color-divider);
    background: var(--color-background-paper);
  }

  .site-footer__inner {
    padding-block: calc(var(--space-unit) * 4);
  }

  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space-unit) * 2);
    list-style: none;
    margin: 0 0 calc(var(--space-unit) * 2);
    padding: 0;
  }

  .site-footer a {
    color: var(--color-text-secondary);
  }

  .site-footer__contact,
  .site-footer__legal {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-block-end: var(--space-unit);
  }
</style>
