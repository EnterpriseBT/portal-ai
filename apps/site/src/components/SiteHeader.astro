---
/** Site-wide navigation. Pure markup + tokens — no client JS beyond the
 *  theme toggle the base layout delegates. */
import { appUrl } from "../lib/site-context.js";

const links = [
  { href: "/features/", label: "Features" },
  { href: "/use-cases/", label: "Use cases" },
  { href: "/pricing/", label: "Pricing" },
  { href: "/contact/", label: "Contact" },
];

const { current } = Astro.props as { current?: string };
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">Portals AI</a>

    <nav aria-label="Primary">
      <ul class="site-header__nav">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={current === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="Toggle colour theme"
        title="Toggle colour theme"
      >
        {
          /* Both icons ship; CSS shows the one matching the resolved theme —
          the sun in light, the moon in dark — mirroring the app's toggle. */
        }
        <svg
          class="theme-toggle__icon theme-toggle__icon--light"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5M2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1m18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1M11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1m0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1M5.99 4.58c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41zm12.37 12.37c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .39-.39.39-1.03 0-1.41zm1.06-10.96c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0zM7.05 18.36c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0z"
          ></path>
        </svg>
        <svg
          class="theme-toggle__icon theme-toggle__icon--dark"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1"
          ></path>
        </svg>
      </button>
      <a class="button button--primary" href={appUrl}>Sign in</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-divider);
    background: var(--color-background-paper);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--space-unit) * 2);
    padding-block: calc(var(--space-unit) * 2);
  }

  .site-header__brand {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    font-size: 1.25rem;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space-unit) * 2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current="page"] {
    color: var(--color-primary-main);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-unit);
    margin-inline-start: auto;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-secondary);
    background: none;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-base);
    padding: calc(var(--space-unit) * 0.5);
    line-height: 0;
  }

  .theme-toggle:hover {
    color: var(--color-primary-main);
  }

  .theme-toggle__icon {
    display: block;
  }

  /* Show the icon for the resolved theme; the base layout sets data-theme
    synchronously before first paint, so there's no wrong-icon flash. */
  :global([data-theme="dark"]) .theme-toggle__icon--light,
  :global([data-theme="light"]) .theme-toggle__icon--dark {
    display: none;
  }
</style>
