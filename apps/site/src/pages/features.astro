---
import Page from "../layouts/Page.astro";
import { GLOSSARY_ENTRIES } from "@portalai/core/content";
import { siteUrl } from "../lib/site-context.js";
import { breadcrumbLd, definedTermSetLd, faqPageLd } from "../lib/jsonld.js";

/**
 * Five pillars, in the order a new user meets them (#360, sharing added in #615). Benefit-led copy —
 * this page sells the product, it is not a glossary. (The in-app vocabulary
 * lives in `@portalai/core/content`; it powers the DefinedTermSet JSON-LD below
 * for SEO, but is deliberately not enumerated in the visible copy.)
 */
const PILLARS: Array<{
  id: string;
  heading: string;
  lede: string;
  points: string[];
}> = [
  {
    id: "connect",
    heading: "Connect anything you already have",
    lede: "CSV and Excel files, Google Sheets, Excel on OneDrive, and REST APIs — bring in the data you already work with. Re-sync a connection whenever its source changes.",
    points: [
      "Ready-made connectors for files, spreadsheets, and the APIs your team already runs.",
      "Sync on demand to pull a source's latest data — no manual re-uploads.",
      "Uploaded data can be edited in Portals AI; data synced from Google Sheets, Excel, and REST APIs is read-only.",
    ],
  },
  {
    id: "normalize",
    heading: "Agree on what the fields mean",
    lede: "Map every source onto a shared vocabulary — types, validation, and canonical formats — so three systems spelling a date three ways stop being three problems.",
    points: [
      "Define a field once; every source maps to the same shape.",
      "Built-in validation catches bad values before they reach a report.",
      "Bring sources together into one view without losing where each record came from.",
    ],
  },
  {
    id: "ask",
    heading: "Ask, don't query",
    lede: "Open a portal and ask in plain language. It answers with tables, charts, maps, and prose built from your live data — and you pin the results worth keeping.",
    points: [
      "Chat with your data — no SQL, no dashboards to wire up first.",
      "Answers arrive as tables, charts, and interactive maps you can explore.",
      "Pin any result to keep it handy; it stays tied to live data.",
    ],
  },
  {
    id: "share",
    heading: "Share it with the right people",
    lede: "Every station, view, and pinned result has an owner, and you decide who else can see or change it. Permissions are checked on the server for every request, so what the app hides it also refuses.",
    points: [
      "Share a station or pinned result with a teammate or the whole team, read-only or editable.",
      "Share a curated view to give read access to just the columns and rows someone needs — with SQL filters on Pro and Enterprise.",
      "Enterprise adds custom roles and policies, sign-in through your own identity provider, and deployment in your own cloud.",
    ],
  },
  {
    id: "extend",
    heading: "Extend what the agent can do",
    lede: "Start with a portal's built-in reasoning, then add more. Toolpacks give the agent new capabilities — turn them on per station and it uses whatever's available.",
    points: [
      "Statistics, forecasting, and financial models over your numbers.",
      "Interactive maps and geocoding for anything with a location.",
      "Live web search — or your own tools, wired in through a webhook.",
    ],
  },
];

const jsonLd = [
  breadcrumbLd(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Features", path: "/features/" },
  ]),
  definedTermSetLd(
    siteUrl,
    GLOSSARY_ENTRIES.map((entry) => ({
      term: entry.term,
      definition: entry.definition,
    }))
  ),
  faqPageLd(),
];
---

<Page
  title="Features — Portals AI"
  description="Connect spreadsheets and APIs; normalise them onto a shared vocabulary; share curated views with your team; then ask questions and get tables, charts and pinned results from your live data."
  path="/features/"
  jsonLd={jsonLd}
>
  <h1>What Portals AI does</h1>
  <p class="muted">
    Connect the data you already have, agree on what it means, ask it questions
    in plain language, and extend how far the agent can go.
  </p>

  {
    PILLARS.map((pillar) => (
      <section class="section" aria-labelledby={pillar.id}>
        <h2 id={pillar.id}>{pillar.heading}</h2>
        <p>{pillar.lede}</p>
        <ul class="points">
          {pillar.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    ))
  }

  <style>
    .points {
      margin: 0;
      padding-inline-start: calc(var(--space-unit) * 2.5);
      display: grid;
      gap: calc(var(--space-unit) * 0.75);
      color: var(--color-text-secondary);
    }

    .points li {
      max-width: 60ch;
    }
  </style>
</Page>
